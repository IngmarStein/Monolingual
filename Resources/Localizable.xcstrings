            "value": "Architekturen"
          }
        }
      }
    },
    "Are you sure you want to remove these languages?": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist Du sicher dass Du diese Sprachen entfernen willst?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε σίγουροι πως θέλετε να αφαιρέσετε αυτές τις γλώσσες?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove these languages?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro que quieres eliminar estos idiomas?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئنید که می خواهید به حذف این زبان؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer ces langues?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste li sigurni da želite ukloniti ove jezike?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler rimuovere queste lingue?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にこれらの言語を削除してもよろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 이 언어 항목들을 삭제하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u deze talen wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno usunąć wybrane języki?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești sigur că veri să elimini pachetele de limbi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эти языки?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Si si istý že chceš vymazať tieto jazyky?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort dess språk?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilleri kaldırmak istediğinizden emin misiniz?"
          }
        }
      }
    },
