{
  "sourceLanguage": "en",
  "strings": {
    "A helper utility from an older version of Monolingual may still be registered. Restart your Mac and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hilfsprogramm einer älteren Monolingual-Version ist möglicherweise noch registriert. Starte deinen Mac neu und versuche es erneut."
          }
        }
      }
    },
    "Allow Monolingual to use its helper tool in System Settings › General › Login Items & Extensions, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Monolingual die Verwendung des Hilfsprogramms in den Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen und versuche es erneut."
          }
        }
      }
    },
    "An outdated helper utility is still installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein veraltetes Hilfsprogramm ist noch installiert."
          }
        }
      }
    },
    "Arch": {
      "extractionState": "stale",
