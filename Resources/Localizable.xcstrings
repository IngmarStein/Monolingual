    "Please keep at least one architecture and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte behalte mindestens eine Architektur und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τουλάχιστον μία αρχιτεκτονική και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please keep at least one architecture and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva al menos una arquitectura e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ".لطفا حداقل یک معماری نگه دارید و دوباره امتحان کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez au moins une architecture et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite barem jednu arhitekturu i pokušajte ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni almeno un’architettura e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 1 つのアーキテクチャを残して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 하나의 아키텍처는 남겨놓으시고 다시 시도해주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud minstens één architectuur en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj co najmniej jedną architekturę i spróbuj ponownie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează cel puțin o arhitectură și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, оставьте одну архитектуру и попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím nechaj aspoň jednu architektúru a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll minst en arkitektur och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen en az bir işlemci mimarisini saklayın ve tekrar deneyin."
          }
        }
      }
    },
