            "value": "Mimariler kaldırılırken hata ayıklama bilgilerini sil"
          }
        }
      }
    },
    "The Monolingual application bundle is incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monolingual-Programmpaket ist unvollständig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πακέτο εφαρμογής του Monolingual είναι ελλιπές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete de la aplicación Monolingual está incompleto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بستهٔ برنامهٔ Monolingual ناقص است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet de l’application Monolingual est incomplet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket aplikacije Monolingual nije potpun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto dell’applicazione Monolingual è incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Monolingual アプリケーションのバンドルが不完全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Monolingual 응용 프로그램 번들이 불완전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De programmabundel van Monolingual is onvolledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet aplikacji Monolingual jest niekompletny."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pachetul aplicației Monolingual este incomplet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет приложения Monolingual неполон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Balík aplikácie Monolingual je neúplný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Monolinguals applikationspaket är ofullständigt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monolingual uygulama paketi eksik."
          }
        }
      }
    },
    "You cancelled the removal. Some files were erased, some were not.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Entfernen abgebrochen. Einige Dateien wurden gelöscht, andere nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταματήσατε την αφαίρεση. Κάποια αρχεία αφαιρέθηκαν, κάποια όχι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the removal. Some files were erased, some were not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cancelado la eliminación. Algunos archivos se borraron y otros no."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ".شما در حذف لغو شده است. برخی از فایل های، پاک شد برخی از نبودند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez interrompu la suppression. Certains fichiers sont effacés, d\\'autres pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekinuli ste uklanjanje. Neke datoteke su obrisane, neke nisu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai annullato la rimozione. Alcuni file sono stati cancellati, altri no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を中止しました。いくつかのファイルは既に削除されてしまいました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 취소하셨습니다. 몇몇 파일은 삭제되었지만, 몇몇 파일은 남아있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U annuleerde de verwijdering. Enkele bestanden werden verwijderd, enkele niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie zostało przerwane przez użytkownika. Nie wszystkie pliki zostały usunięte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai anulat procesul de elimnare. Anumite date au fost șterse, altele nu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отменили удаление. Некоторые файлы были стёрты, некоторые нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušil si vymazávanie. Niektoré súbory sú vymazané, niektoré nie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du avbröt borttagningen. Vissa filer blev borttagna, vissa inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırma işlemini iptal ettiniz. Bazı dosyalar silindi, bazıları silinmedi."
          }
        }
      }
    },
    "You will not be able to restore them without reinstalling macOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Pakete nicht wiederherstellen, ohne macOS neu zu installieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να τις χρησιμοποιήσετε ξανά θα πρέπει να επανεγκαταστήσετε το λειτουργικό σύστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not be able to restore them without reinstalling macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás restaurarlos sin reinstalar macOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما نمی قادر خواهد بود به بازگرداندن آنها بدون نصب مجدد از MacOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera nécessaire de réinstaller macOS si jamais vous voulez les restaurer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemožete ih više povratiti bez reinstalacije macOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarai in grado di ripristinarle senza reinstallare macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すためには macOS を再インストールする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS를 재설치 하지 않는 이상 다시 돌릴수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt ze niet meer herstellen zonder macOS opnieuw te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie ich będzie się wiązało z przeinstalowaniem systemu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vei mai avea posibilitatea de a revendica aceste pachete, doar dacă vei reinstala macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не сможете восстановить их без переустановки macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieje možné ich vrátiť naspäť bez preinštalovania macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte återfå dem utan att installera om macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz. Bu dillere ihtiyaç duymanız durumunda macOS'u baştan kurmak zorunda kalacaksınız."
          }
        }
      }
    },
    "Your OS has not been modified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein System wurde nicht verändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λειτουργικό σύστημα δεν τροποποιήθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your OS has not been modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sistema operativo no se ha modificado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ".سیستم عامل خود را اصلاح نشده است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre système est intact."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš OS nije promijenjen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Sistema non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは改変されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS의 언어 파일들이 변하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw besturingssysteem is niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System nie został zmodyfikowany."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nu a fost modificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша OS не была изменена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj OS nebol modifikovaný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt operativsystem har inte ändrats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşletim sisteminizde bir değişiklik yapılmadı"
          }
        }
      }
    },
