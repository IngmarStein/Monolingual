    "The Monolingual application bundle is incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monolingual-Programmpaket ist unvollständig."
          }
        }
      }
    },
    "You cancelled the removal. Some files were erased, some were not.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Entfernen abgebrochen. Einige Dateien wurden gelöscht, andere nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταματήσατε την αφαίρεση. Κάποια αρχεία αφαιρέθηκαν, κάποια όχι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the removal. Some files were erased, some were not."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ".شما در حذف لغو شده است. برخی از فایل های، پاک شد برخی از نبودند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez interrompu la suppression. Certains fichiers sont effacés, d\\'autres pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekinuli ste uklanjanje. Neke datoteke su obrisane, neke nisu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai annullato la rimozione. Alcuni file sono stati cancellati, altri no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を中止しました。いくつかのファイルは既に削除されてしまいました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 취소하셨습니다. 몇몇 파일은 삭제되었지만, 몇몇 파일은 남아있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U annuleerde de verwijdering. Enkele bestanden werden verwijderd, enkele niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie zostało przerwane przez użytkownika. Nie wszystkie pliki zostały usunięte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai anulat procesul de elimnare. Anumite date au fost șterse, altele nu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отменили удаление. Некоторые файлы были стёрты, некоторые нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušil si vymazávanie. Niektoré súbory sú vymazané, niektoré nie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du avbröt borttagningen. Vissa filer blev borttagna, vissa inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırma işlemini iptal ettiniz. Bazı dosyalar silindi, bazıları silinmedi."
          }
        }
      }
    },
    "You will not be able to restore them without reinstalling macOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Pakete nicht wiederherstellen, ohne macOS neu zu installieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να τις χρησιμοποιήσετε ξανά θα πρέπει να επανεγκαταστήσετε το λειτουργικό σύστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not be able to restore them without reinstalling macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás restaurarlos sin reinstalar macOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما نمی قادر خواهد بود به بازگرداندن آنها بدون نصب مجدد از MacOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera nécessaire de réinstaller macOS si jamais vous voulez les restaurer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemožete ih više povratiti bez reinstalacije macOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarai in grado di ripristinarle senza reinstallare macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すためには macOS を再インストールする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS를 재설치 하지 않는 이상 다시 돌릴수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt ze niet meer herstellen zonder macOS opnieuw te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie ich będzie się wiązało z przeinstalowaniem systemu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vei mai avea posibilitatea de a revendica aceste pachete, doar dacă vei reinstala macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не сможете восстановить их без переустановки macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieje možné ich vrátiť naspäť bez preinštalovania macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte återfå dem utan att installera om macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz. Bu dillere ihtiyaç duymanız durumunda macOS'u baştan kurmak zorunda kalacaksınız."
          }
        }
      }
    },
    "Your OS has not been modified.": {
      "localizations": {
