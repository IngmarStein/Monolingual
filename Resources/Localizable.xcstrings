    "Removing all architectures will make macOS inoperable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen aller Architekturen macht macOS unbrauchbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αφαίρεση όλων των αρχιτεκτονικών θα καταστήσει το macOS μη λειτουργικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing all architectures will make macOS inoperable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todas las arquitecturas hará que macOS deje de funcionar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ".از بین بردن تمام معماری از MacOS غیر قابل جراحی خواهد شد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les architectures rendra macOS inutilisable."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjanje svih arhitektura onemogućit će rad sustava macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere tutte le architetture renderà macOS inutilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアーキテクチャを削除すると macOS が動作しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 에서 사용되지 않는 모든 아키텍처를 삭제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle architecturen verwijderen maakt macOS onbruikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie wszystkich architektur uniemożliwi działanie macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea tuturor arhitecturilor va face macOS inutilizabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление всех архитектур сделает macOS нерабочей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazatím všetkých architektúr spravíš macOS nepoužiteľný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tar bort alla arkitekturer slutar macOS att fungera."
          }
        },
