opt_out_usage

default_platform(:mac)

platform :mac do
  before_all do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      strict: false,
      ignore_exit_status: false,
      quiet: false
    )
  end

  desc "Runs all the tests"
  lane :test do
    sh("swift test")
  end

  desc "Build a new beta version with debug information"
  lane :build_debug do
    archive_and_copy(configuration: "Debug")
  end

  desc "Build a new release version"
  lane :release do
    archive_and_copy(configuration: "Release")
  end

  # Xcode 27 rejects -exportArchive for Monolingual ("exportOptionsPlist error for key
  # \"method\" expected one {}": no distribution method is eligible), and fastlane's
  # build_app always exports. The app is signed with the Developer ID identity and the
  # hardened runtime while it is built, which is what notarization requires, so the
  # archive is built with xcodebuild and the app is taken straight out of it.
  private_lane :archive_and_copy do |options|
    configuration = options[:configuration]
    root = File.expand_path("..", __dir__)
    archive_path = File.join(root, "build/Monolingual.xcarchive")
    derived_data_path = File.join(root, "build/DerivedData")
    output_directory = File.join(root, "build")

    FileUtils.rm_rf(archive_path)
    sh("xcodebuild archive" \
       " -project #{root}/Monolingual.xcodeproj" \
       " -scheme Monolingual" \
       " -configuration #{configuration}" \
       " -destination platform=macOS" \
       " -derivedDataPath #{derived_data_path}" \
       " -archivePath #{archive_path}")

    app = File.join(archive_path, "Products/Applications/Monolingual.app")
    dsym = File.join(archive_path, "dSYMs/Monolingual.app.dSYM")
    UI.user_error!("No app in #{archive_path}") unless File.exist?(app)

    FileUtils.rm_rf(File.join(output_directory, "Monolingual.app"))
    FileUtils.rm_rf(File.join(output_directory, "Monolingual.app.dSYM"))
    FileUtils.rm_rf(File.join(output_directory, "Monolingual.app.dSYM.zip"))
    FileUtils.cp_r(app, output_directory)
    if File.exist?(dsym)
      FileUtils.cp_r(dsym, output_directory)
      sh("ditto -c -k --keepParent #{output_directory}/Monolingual.app.dSYM #{output_directory}/Monolingual.app.dSYM.zip")
    end
  end

  desc "Notarize the app and DMG"
  lane :notarize_artifacts do
    notarize(
      package: "./build/Monolingual.app",
      try_early_stapling: true,
      bundle_id: "com.github.IngmarStein.Monolingual",
      username: "ingmarstein@icloud.com",
      asc_provider: "ADVP2P7SJK",
      print_log: true,
      verbose: true
    )
    
    notarize(
      package: "./build/Monolingual.dmg",
      try_early_stapling: true,
      bundle_id: "com.github.IngmarStein.Monolingual",
      username: "ingmarstein@icloud.com",
      asc_provider: "ADVP2P7SJK",
      print_log: true,
      verbose: true
    )
  end
end
